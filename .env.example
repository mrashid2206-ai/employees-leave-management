# ── Database ─────────────────────────────────────────────────────────────────
# Either a full connection string (preferred, e.g. on Railway)…
DATABASE_URL=postgresql://user:password@host:5432/employees_db
# …or discrete parts (used only when DATABASE_URL is unset):
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=
# DB_NAME=employees_db

# ── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED. Long random string (>= 32 chars) used to sign JWTs (HS256).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Bootstrap admin password. The username "admin" can log in with THIS password ONLY
# while no row exists in the admin_users table (e.g. a fresh database), so you can
# create real admin accounts. Leave unset to disable the bootstrap login entirely.
# There is no hardcoded fallback password anymore.
ADMIN_PASSWORD=

# ── Cross-origin / CSRF hardening (optional) ─────────────────────────────────
# Public app URL(s). Origins matching these (or the request Host) are allowed for
# /api/* requests. Comma-separate multiple hosts in ALLOWED_ORIGINS.
APP_URL=https://your-app.up.railway.app
# ALLOWED_ORIGINS=https://your-app.up.railway.app,https://custom-domain.com

# ── Schema migrations ────────────────────────────────────────────────────────
# Migrations live in db/migrations/*.sql and are applied with `npm run migrate`
# (run it locally/CI/once on deploy). Set RUN_MIGRATIONS_AT_BOOT=true to also apply
# pending migrations automatically when the server starts (opt-in; default off).
RUN_MIGRATIONS_AT_BOOT=false

# ── Scheduled automation (cron) ──────────────────────────────────────────────
# Bearer token that authorizes the scheduled daily/yearly automation endpoints
# (/api/cron/daily, /api/cron/yearly). Set the SAME value here and as the GitHub
# Actions repo secret CRON_SECRET (+ APP_URL). If unset, the cron endpoints 401
# and you must run the automation manually from Settings. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# ── Web Push notifications (optional) ────────────────────────────────────────
# Enables installable-PWA push reminders ("you haven't checked in yet").
# Generate a key pair once:  npx web-push generate-vapid-keys
# Leave unset to disable push entirely (the app works fine without it).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── Email notifications (optional) ───────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Where leave approval/rejection emails are sent (defaults to SMTP_USER):
NOTIFY_EMAIL=
